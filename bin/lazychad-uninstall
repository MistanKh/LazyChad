#!/bin/bash
# LazyChad Uninstaller — full, install-method-aware removal.
# Removes the LazyChad package (or manual install), the /usr/local Neovim
# install, and user dirs, in that order; a failed package removal stops it
# before anything else is touched. Leaves shared deps (Node, Rust, Neovide,
# fonts) untouched. Confirms and offers a config backup first. Run as a normal
# user; uses sudo.

BOLD="\033[1m"; GREEN="\033[0;32m"; BLUE="\033[0;34m"; YELLOW="\033[0;33m"; RED="\033[0;31m"; NC="\033[0m"

parse_yes() {
    case "${1:-}" in
        -y|--yes) echo "true" ;;
        *)        echo "false" ;;
    esac
}

confirm() {
    # $1=prompt ; honours global ASSUME_YES
    if [ "${ASSUME_YES:-false}" = "true" ]; then return 0; fi
    read -p "$1 (y/N) " -n 1 -r; echo
    [[ $REPLY =~ ^[Yy]$ ]]
}

backup_user_config() {
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/LazyChad"
    if [ -d "$cfg" ] && confirm "Back up $cfg before removing?"; then
        local dest
        dest="${cfg}_backup_$(date +%Y%m%d_%H%M%S)"
        cp -a "$cfg" "$dest"
        echo -e "${GREEN}🗄️  Backed up to $dest${NC}"
    fi
}

user_dirs() {
    # Every user's LazyChad dirs, plus this user's XDG locations if they differ.
    local home sub var val
    for home in ${LAZYCHAD_HOMES:-/home/* /root}; do
        [ -d "$home" ] || continue
        for sub in .config/LazyChad .local/share/LazyChad .local/state/LazyChad .cache/LazyChad; do
            [ -d "$home/$sub" ] && echo "$home/$sub"
        done
    done
    for var in XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME; do
        val="${!var:-}"
        [ -n "$val" ] && [ -d "$val/LazyChad" ] && echo "$val/LazyChad"
    done
    return 0
}

remove_user_dirs() {
    local dir
    while IFS= read -r dir; do
        [ -n "$dir" ] || continue
        sudo rm -rf -- "${dir:?}"
        echo "  -> removed $dir"
    done < <(user_dirs | sort -u)
}

nvim_tarball_paths() {
    # Everything the official Neovim tarball puts under /usr/local (kept in
    # sync with lazychad-nvim; tests compare the two).
    local p
    for p in /usr/local/bin/nvim /usr/local/lib/nvim /usr/local/share/nvim/runtime \
             /usr/local/share/applications/nvim.desktop /usr/local/share/man/man1/nvim.1 \
             /usr/local/share/icons/hicolor/*/apps/nvim.png \
             /usr/local/share/locale/*/LC_MESSAGES/nvim.mo /usr/local/nvim; do
        { [ -e "$p" ] || [ -L "$p" ]; } && echo "$p"
    done
    return 0
}

remove_neovim() {
    local paths=()
    mapfile -t paths < <(nvim_tarball_paths)
    if [ "${#paths[@]}" -eq 0 ]; then
        echo "No Neovim install under /usr/local."
        return 0
    fi
    echo -e "${BLUE}Removing Neovim under /usr/local...${NC}"
    sudo rm -rf -- "${paths[@]}" || echo -e "${RED}⚠️ Some /usr/local Neovim files could not be removed.${NC}"
    sudo rmdir /usr/local/share/nvim 2>/dev/null || true
}

detect_install() {
    if command -v dpkg >/dev/null 2>&1 && dpkg -S /usr/bin/lchad >/dev/null 2>&1; then
        echo dpkg
    elif command -v pacman >/dev/null 2>&1 && pacman -Qo /usr/bin/lchad >/dev/null 2>&1; then
        echo pacman
    elif command -v rpm >/dev/null 2>&1 && rpm -qf /usr/bin/lchad >/dev/null 2>&1; then
        echo rpm
    else
        echo manual
    fi
}

remove_lazychad_package() {
    # Returns the package manager's status, so a failure stops the uninstall.
    case "$(detect_install)" in
        dpkg)
            # purge, not remove: a removed-but-not-purged package keeps its
            # postrm armed, and a later purge would wipe data again.
            echo -e "${BLUE}Detected dpkg install. Purging the lazychad package...${NC}"
            sudo apt-get purge -y lazychad ;;
        pacman)
            echo -e "${BLUE}Detected pacman install. Removing the lazychad package...${NC}"
            sudo pacman -R --noconfirm lazychad ;;
        rpm)
            echo -e "${BLUE}Detected rpm install. Removing the lazychad package...${NC}"
            if command -v dnf >/dev/null 2>&1; then
                sudo dnf remove -y lazychad
            elif command -v zypper >/dev/null 2>&1; then
                sudo zypper remove -y lazychad
            else
                sudo rpm -e lazychad
            fi ;;
        manual)
            echo -e "${BLUE}Removing manual LazyChad install...${NC}"
            sudo rm -f /usr/bin/lchad /usr/bin/lazychad-deps /usr/bin/lazychad-nvim /usr/bin/lazychad-uninstall \
                && sudo rm -rf /usr/share/lazychad /usr/share/doc/lazychad /usr/share/licenses/lazychad ;;
    esac
}

main() {
    ASSUME_YES="$(parse_yes "${1:-}")"

    echo -e "${BOLD}=== LazyChad Uninstaller ===${NC}"
    echo "The following will be removed:"
    echo "  - The LazyChad package or manual install (lchad, lazychad-deps, lazychad-nvim, lazychad-uninstall)"
    echo "  - Neovim installed under /usr/local by lazychad-nvim"
    echo "  - User dirs: ~/.config/LazyChad, ~/.local/share/LazyChad, ~/.local/state/LazyChad,"
    echo "    ~/.cache/LazyChad (all users)"
    echo -e "${YELLOW}Shared deps (Node, Rust, Neovide, fonts, -dev packages) will NOT be removed.${NC}"
    echo

    if ! confirm "Proceed with uninstall?"; then
        echo "Aborted."
        exit 0
    fi

    backup_user_config   # before any package-manager hook runs
    if ! remove_lazychad_package; then
        echo -e "${RED}❌ Removing the LazyChad package failed; Neovim and user data were NOT touched.${NC}"
        echo "   Fix the error above (e.g. another package manager holding the lock) and re-run lazychad-uninstall."
        exit 1
    fi
    remove_neovim
    remove_user_dirs

    echo -e "${GREEN}✅ LazyChad has been uninstalled.${NC}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    set -uo pipefail
    main "$@"
fi
