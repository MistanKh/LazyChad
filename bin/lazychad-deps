#!/bin/bash
# LazyChad Universal Dependency Installer
# Supports: Arch / Debian / Fedora families (incl. derivatives via ID_LIKE).
#
# Best-effort by design: a single failing optional step does NOT abort the
# whole setup. Failures are collected and reported at the end so you always
# know exactly what to fix, instead of dying halfway through.
#
# Nothing is installed globally that LazyChad doesn't need: the Node provider
# and tree-sitter CLI go into a private npm prefix, pynvim comes from the
# distro, and the Neovide GUI (plus Rust, if it has to be built) is opt-in.

BOLD="\033[1m"
GREEN="\033[0;32m"
BLUE="\033[0;34m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
NC="\033[0m" # No Color

LAZYCHAD_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/LazyChad"
LAZYCHAD_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/LazyChad"
NODE_PREFIX="$LAZYCHAD_DATA/node"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Options (set by parse_args)
WITH_GUI=false
SKIP_NVIM=false
DO_BOOTSTRAP=true
NVIM_CHANNEL_FLAG=""

# Collect non-fatal failures so we can summarize at the end.
FAILED_STEPS=()
warn_fail() { echo -e "${RED}⚠️  $1${NC}"; FAILED_STEPS+=("$1"); }

exists() {
    command -v "$1" >/dev/null 2>&1
}

usage() {
    cat <<'EOF'
LazyChad Dependency Installer

Usage: lazychad-deps [options]

Options:
  --gui           Also install the Neovide GUI (builds with Rust if no prebuilt fits)
  --nightly       Install Neovim nightly instead of the latest stable release
  --skip-nvim     Don't install or update Neovim
  --no-bootstrap  Don't pre-install plugins, Mason tools and parsers
  -h, --help      Show this help

Run as your normal user; it asks for sudo only for system packages.
A log of each run is kept in ~/.local/state/LazyChad/lazychad-deps.log.
EOF
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --gui)          WITH_GUI=true ;;
            --stable)       NVIM_CHANNEL_FLAG="--stable" ;;
            --nightly)      NVIM_CHANNEL_FLAG="--nightly" ;;
            --skip-nvim)    SKIP_NVIM=true ;;
            --no-bootstrap) DO_BOOTSTRAP=false ;;
            -h|--help)      usage; exit 0 ;;
            *)              echo -e "${RED}Unknown option: $1${NC}"; usage; exit 2 ;;
        esac
        shift
    done
}

detect_family() {
    # $1=ID  $2=ID_LIKE from os-release. Normalizes derivatives (Mint,
    # EndeavourOS, Rocky, Pop!_OS, ...) onto arch/debian/fedora.
    case "$1" in
        arch|cachyos|manjaro|endeavouros|garuda|arcolinux|artix) echo "arch" ;;
        debian|ubuntu|pop|kali|linuxmint|elementary|zorin|raspbian|devuan|mx|parrot) echo "debian" ;;
        fedora|rhel|centos|rocky|almalinux|ol|nobara) echo "fedora" ;;
        *)
            case " $2 " in
                *arch*)                   echo "arch" ;;
                *debian*|*ubuntu*)        echo "debian" ;;
                *fedora*|*rhel*|*centos*) echo "fedora" ;;
                *)                        echo "$1" ;;
            esac
            ;;
    esac
}

os_release_field() {
    # $1=field. Read in a subshell so os-release can't clobber our variables.
    local file="${OS_RELEASE_FILE:-/etc/os-release}"
    [ -f "$file" ] || return 0
    # shellcheck source=/dev/null
    ( . "$file"; eval "printf '%s' \"\${$1:-}\"" )
}

find_helper() {
    if exists "$1"; then
        command -v "$1"
    elif [ -x "$SCRIPT_DIR/$1" ]; then
        echo "$SCRIPT_DIR/$1"
    else
        return 1
    fi
}

github_api() {
    # GET a GitHub API URL; uses $GITHUB_TOKEN when set (avoids rate limits in CI).
    if [ -n "${GITHUB_TOKEN:-}" ]; then
        curl -fsSL -H "Authorization: Bearer $GITHUB_TOKEN" "$1"
    else
        curl -fsSL "$1"
    fi
}

release_asset_digest() {
    # $1=release JSON file (GitHub API)  $2=asset name; prints its sha256 or nothing.
    # Splits the JSON into one field per line and tracks the current asset name.
    tr ',{}' '\n\n\n' < "$1" | awk -v want="\"$2\"" '
        /"name"[[:space:]]*:/ { cur = $0; sub(/^[^:]*:[[:space:]]*/, "", cur); gsub(/[[:space:]]+$/, "", cur) }
        /"digest"[[:space:]]*:[[:space:]]*"sha256:/ && cur == want {
            sub(/.*"sha256:/, ""); sub(/".*/, ""); print; exit
        }'
}

# Install a list of packages best-effort. Try one batch first (fast); if that
# fails — usually a single missing/renamed package aborting the whole apt/dnf
# run — retry each package individually so the good ones still land, and report
# only the ones that genuinely couldn't be installed. Uses the global PKG_MANAGER.
install_resilient() {
    local label="$1"; shift
    [ "$#" -eq 0 ] && return 0
    if $PKG_MANAGER "$@"; then
        return 0
    fi
    echo -e "${YELLOW}Batch install hit an error; retrying packages individually...${NC}"
    local p failed=()
    for p in "$@"; do
        $PKG_MANAGER "$p" || failed+=("$p")
    done
    if [ "${#failed[@]}" -gt 0 ]; then
        warn_fail "$label: could not install (may not exist on your distro): ${failed[*]}"
    fi
}

pkg_command() {
    # Command a package provides, so equivalents installed another way (e.g.
    # NodeSource nodejs bundling npm, nodejs-lts-* on Arch, curl-minimal on
    # Fedora) count as installed instead of conflicting on every run.
    case "$1" in
        nodejs) echo node ;;
        npm|git|curl|tar|unzip|make|gcc|cmake|luarocks|xclip|python3) echo "$1" ;;
        python) echo python3 ;;
        ripgrep) echo rg ;;
        fd) echo fd ;;
        fd-find) echo fdfind ;;
        wl-clipboard) echo wl-copy ;;
        *) return 1 ;;
    esac
}

is_present() {
    local cmd
    check_installed "$1" && return 0
    cmd="$(pkg_command "$1")" && exists "$cmd"
}

install_missing() {
    # $1=label, rest=packages; installs only the ones not already present
    local label="$1"; shift
    local dep missing=()
    for dep in "$@"; do
        is_present "$dep" || missing+=("$dep")
    done
    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${BLUE}Installing: ${missing[*]}${NC}"
        install_resilient "$label" "${missing[@]}"
    else
        echo -e "${GREEN}✅ $label already installed.${NC}"
    fi
}

set_family_packages() {
    # Sets PKG_MANAGER, check_installed, DEPS, GUI_DEPS and NEOVIDE_BUILD_DEPS.
    GUI_DEPS=()
    NEOVIDE_BUILD_DEPS=()
    case "$FAMILY" in
        arch)
            PKG_MANAGER="sudo pacman -S --needed --noconfirm"
            DEPS=(
                "git" "curl" "tar" "unzip" "make" "gcc" "cmake"
                "nodejs" "npm" "python" "python-pip" "python-pynvim"
                "ripgrep" "fd" "ttf-jetbrains-mono-nerd"
                "lua51" "luarocks" "lua-jsregexp"
                "wl-clipboard" "xclip"
            )
            GUI_DEPS=("neovide")
            # -T resolves provides (nodejs-lts-* satisfies nodejs).
            check_installed() { pacman -T "$1" >/dev/null 2>&1; }
            ;;
        debian)
            PKG_MANAGER="sudo apt-get install -y"
            DEPS=(
                "git" "curl" "tar" "unzip" "make" "gcc" "cmake" "gnupg" "ca-certificates"
                "nodejs" "npm" "python3" "python3-pip" "python3-pynvim"
                "ripgrep" "fd-find" "fontconfig" "xz-utils"
                "lua5.1" "luarocks" "wl-clipboard" "xclip"
            )
            # Runtime libs the prebuilt Neovide binary links against (not the -dev
            # headers — those are only for the cargo build fallback).
            GUI_DEPS=(
                "libfreetype6" "libfontconfig1" "libxcursor1" "libxi6" "libxrandr2" "libgl1"
            )
            # Renamed to libasound2t64 on newer Debian/Ubuntu.
            if apt-cache show libasound2t64 >/dev/null 2>&1; then
                GUI_DEPS+=("libasound2t64")
            else
                GUI_DEPS+=("libasound2")
            fi
            NEOVIDE_BUILD_DEPS=(
                "libssl-dev" "pkg-config" "libfreetype6-dev"
                "libasound2-dev" "libexpat1-dev" "libxcb-composite0-dev" "libbz2-dev"
                "libsndio-dev" "libglut-dev" "libxmu-dev" "libxi-dev" "libfontconfig1-dev"
                "libxcursor-dev"
            )
            # multilib packages exist (and are needed) only on x86_64.
            [ "$(uname -m)" = "x86_64" ] && NEOVIDE_BUILD_DEPS+=("gcc-multilib" "g++-multilib")
            # dpkg -l also succeeds for removed-but-not-purged ("rc") packages,
            # so check the real install status instead.
            check_installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"; }
            ;;
        fedora)
            PKG_MANAGER="sudo dnf install -y"
            DEPS=(
                "git" "curl" "tar" "unzip" "make" "gcc" "gcc-c++" "cmake"
                "nodejs" "npm" "python3" "python3-pip" "python3-neovim"
                "ripgrep" "fd-find" "fontconfig" "xz"
                "lua5.1" "luarocks" "wl-clipboard" "xclip"
            )
            GUI_DEPS=(
                "freetype" "fontconfig" "alsa-lib" "libXcursor" "libXi" "libXrandr" "mesa-libGL"
            )
            NEOVIDE_BUILD_DEPS=(
                "fontconfig-devel" "freetype-devel" "libstdc++-static" "libstdc++-devel"
            )
            check_installed() { rpm -q --whatprovides "$1" >/dev/null 2>&1; }
            ;;
        *)
            return 1
            ;;
    esac
}

step_neovim() {
    echo -e "\n${BOLD}${YELLOW}[2/6] Neovim (0.12+)${NC}"
    if [ "$SKIP_NVIM" = true ]; then
        echo "Skipped (--skip-nvim)."
        return 0
    fi
    local installer
    if installer="$(find_helper lazychad-nvim)"; then
        # shellcheck disable=SC2086
        "$installer" --update $NVIM_CHANNEL_FLAG || warn_fail "Neovim install/update reported a problem"
    else
        warn_fail "lazychad-nvim not found; install Neovim 0.12+ from https://github.com/neovim/neovim/releases"
    fi
}

install_nerd_font() {
    # Debian/Fedora don't package the Nerd Font variant (fonts-jetbrains-mono
    # has no icons), so fetch JetBrainsMono Nerd Font into the user's fonts.
    local font_dir="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/JetBrainsMonoNerdFont"
    local asset="JetBrainsMono.tar.xz" tmp expected actual
    if exists fc-list && fc-list 2>/dev/null | grep -qi "JetBrainsMono Nerd Font"; then
        echo -e "${GREEN}✅ JetBrainsMono Nerd Font is already installed.${NC}"
        return 0
    fi
    echo -e "${BLUE}Installing JetBrainsMono Nerd Font into $font_dir...${NC}"
    tmp="$(mktemp -d)"
    if ! curl -fSL "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/$asset" -o "$tmp/$asset"; then
        rm -rf "$tmp"
        warn_fail "Nerd Font download failed; icons may render as boxes"
        return 0
    fi
    expected=""
    if github_api https://api.github.com/repos/ryanoasis/nerd-fonts/releases/latest >"$tmp/release.json" 2>/dev/null; then
        expected="$(release_asset_digest "$tmp/release.json" "$asset")"
    fi
    if [ -n "$expected" ]; then
        actual="$(sha256sum "$tmp/$asset" | awk '{ print $1 }')"
        if [ "$actual" != "$expected" ]; then
            rm -rf "$tmp"
            warn_fail "Nerd Font checksum mismatch; not installed"
            return 0
        fi
    else
        echo -e "${YELLOW}Could not fetch the published checksum; skipping verification.${NC}"
    fi
    # Only the four styles a terminal/Neovide uses (the full family is huge).
    tar -xJf "$tmp/$asset" -C "$tmp" --wildcards --no-anchored \
        'JetBrainsMonoNerdFont-Regular.ttf' 'JetBrainsMonoNerdFont-Bold.ttf' \
        'JetBrainsMonoNerdFont-Italic.ttf' 'JetBrainsMonoNerdFont-BoldItalic.ttf' 2>/dev/null
    if ! find "$tmp" -name 'JetBrainsMonoNerdFont-Regular.ttf' | grep -q .; then
        rm -rf "$tmp"
        warn_fail "Nerd Font archive had no JetBrainsMonoNerdFont-Regular.ttf; not installed"
        return 0
    fi
    mkdir -p "$font_dir"
    find "$tmp" -name 'JetBrainsMonoNerdFont-*.ttf' -exec cp {} "$font_dir/" \;
    rm -rf "$tmp"
    exists fc-cache && fc-cache -f "$font_dir" >/dev/null 2>&1
    echo -e "${GREEN}✅ JetBrainsMono Nerd Font installed. Select it in your terminal's settings.${NC}"
}

epel_enabled() {
    dnf repolist --enabled 2>/dev/null | grep -qi '^epel'
}

step_system_packages() {
    echo -e "\n${BOLD}${YELLOW}[1/6] System packages${NC}"
    if [ "$SUPPORTED" != true ]; then
        warn_fail "No package list for '$OS_ID': install these yourself: git curl tar unzip make gcc ripgrep fd nodejs npm python3 + pynvim, xclip or wl-clipboard"
        install_nerd_font
        return 0
    fi
    if [ "$FAMILY" = "fedora" ] && [ "$OS_ID" != "fedora" ] && ! epel_enabled; then
        warn_fail "EPEL is not enabled; ripgrep, fd-find, pynvim and others come from EPEL on $OS_ID (dnf install epel-release && dnf config-manager --set-enabled crb)"
    fi
    if [ "$FAMILY" = "debian" ]; then
        sudo apt-get update || warn_fail "apt-get update failed (network?); package install may be incomplete"
    fi
    install_missing "System packages" "${DEPS[@]}"
    [ "$FAMILY" = "arch" ] || install_nerd_font   # Arch: ttf-jetbrains-mono-nerd above

    # On Debian/Fedora the package is 'fd-find' and ships the binary as 'fdfind';
    # Telescope/NvChad expect 'fd'. Bridge it with a user-local symlink.
    if [ "$FAMILY" != "arch" ] && ! exists fd && exists fdfind; then
        mkdir -p "$HOME/.local/bin"
        if ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"; then
            echo -e "${GREEN}🔗 Linked fdfind -> ~/.local/bin/fd${NC}"
            case ":$PATH:" in
                *":$HOME/.local/bin:"*) ;;
                *) echo -e "${YELLOW}   Add ~/.local/bin to your PATH so 'fd' is found.${NC}" ;;
            esac
        else
            warn_fail "Could not link fdfind -> fd"
        fi
    fi
}

step_node_tools() {
    # Private npm prefix: no root-owned files, no clash with the user's global
    # npm packages. options.lua points Neovim at these.
    echo -e "\n${BOLD}${YELLOW}[3/6] Node provider and tree-sitter CLI${NC}"
    if ! exists npm; then
        warn_fail "npm not found; skipping Node provider and tree-sitter CLI"
        return 0
    fi
    mkdir -p "$NODE_PREFIX"
    echo -e "${BLUE}Installing neovim + tree-sitter-cli into $NODE_PREFIX...${NC}"
    if npm install --prefix "$NODE_PREFIX" --no-fund --no-audit --loglevel=error \
            neovim@latest tree-sitter-cli@latest; then
        echo -e "${GREEN}✅ Node provider and tree-sitter CLI ready.${NC}"
    else
        warn_fail "npm install of neovim/tree-sitter-cli failed"
    fi
}

step_python_provider() {
    echo -e "\n${BOLD}${YELLOW}[4/6] Python provider (pynvim)${NC}"
    if ! exists python3; then
        warn_fail "python3 not found; skipping Python provider (pynvim)"
        return 0
    fi
    if python3 -c "import pynvim" >/dev/null 2>&1; then
        echo -e "${GREEN}✅ pynvim is available.${NC}"
        return 0
    fi
    # The distro package (step 2) is preferred; this covers a python3 that
    # isn't the system one. No --break-system-packages: it only touches the
    # user site, and PEP 668 distros get pynvim from step 2 instead.
    echo -e "${BLUE}Distro pynvim not importable; trying pip --user...${NC}"
    if python3 -m pip install --user --upgrade pynvim && python3 -c "import pynvim" >/dev/null 2>&1; then
        echo -e "${GREEN}✅ pynvim installed.${NC}"
    else
        warn_fail "pynvim not importable by $(command -v python3); install your distro's pynvim package"
    fi
}

install_rust() {
    exists cargo && return 0
    echo -e "${BLUE}Installing Rust via rustup (needed to build Neovide)...${NC}"
    if curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y; then
        # shellcheck source=/dev/null
        [ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
        exists cargo
    else
        return 1
    fi
}

step_neovide() {
    echo -e "\n${BOLD}${YELLOW}[5/6] Neovide GUI (optional)${NC}"
    if [ "$WITH_GUI" != true ]; then
        echo "Skipped. Run 'lazychad-deps --gui' to install the Neovide GUI."
        return 0
    fi
    if exists neovide; then
        echo -e "${GREEN}✅ Neovide is already installed.${NC}"
        return 0
    fi

    [ "$SUPPORTED" = true ] && install_missing "Neovide runtime libraries" "${GUI_DEPS[@]}"
    [ "$FAMILY" = "arch" ] && return 0

    # Prefer the official prebuilt x86_64 binary (fast, no compile). Fall back
    # to building from source with cargo for other architectures.
    if [ "$(uname -m)" = "x86_64" ]; then
        echo -e "${BLUE}Installing the official prebuilt Neovide binary...${NC}"
        local nv_tmp
        nv_tmp="$(mktemp -d)"
        if curl -fSL "https://github.com/neovide/neovide/releases/latest/download/neovide-linux-x86_64.tar" \
                -o "$nv_tmp/neovide.tar" \
           && tar -xf "$nv_tmp/neovide.tar" -C "$nv_tmp" \
           && sudo install -Dm755 "$nv_tmp/neovide" /usr/local/bin/neovide; then
            rm -rf "$nv_tmp"
            echo -e "${GREEN}✅ Neovide installed to /usr/local/bin/neovide.${NC}"
            return 0
        fi
        rm -rf "$nv_tmp"
        echo -e "${YELLOW}Prebuilt download failed; building from source instead...${NC}"
    fi

    if ! install_rust; then
        warn_fail "Rust install failed; can't build Neovide"
        return 0
    fi
    [ "$SUPPORTED" = true ] && install_resilient "Neovide build deps" "${NEOVIDE_BUILD_DEPS[@]}"
    echo -e "${BLUE}Building Neovide from source (this may take a few minutes)...${NC}"
    cargo install --git https://github.com/neovide/neovide.git \
        || warn_fail "Neovide build from source failed"
}

step_bootstrap() {
    echo -e "\n${BOLD}${YELLOW}[6/6] LazyChad plugins and tools${NC}"
    if [ "$DO_BOOTSTRAP" != true ]; then
        echo "Skipped (--no-bootstrap). 'lchad' will do this on first launch."
        return 0
    fi
    local lchad
    if ! lchad="$(find_helper lchad)"; then
        echo -e "${YELLOW}lchad not found; plugins will install on first launch.${NC}"
        return 0
    fi
    hash -r
    if ! exists nvim; then
        warn_fail "Neovim not available; skipped plugin setup"
        return 0
    fi
    # Make the tools from step 3 visible to the bootstrap (options.lua also
    # adds this for normal launches).
    PATH="$NODE_PREFIX/node_modules/.bin:$PATH" "$lchad" --bootstrap \
        || warn_fail "Plugin/tool setup incomplete; re-run 'lchad --bootstrap'"
}

print_summary() {
    echo ""
    if [ ${#FAILED_STEPS[@]} -eq 0 ]; then
        echo -e "${BOLD}${GREEN}✨ Installation Complete!${NC}"
    else
        echo -e "${BOLD}${YELLOW}⚠️  Installation finished with ${#FAILED_STEPS[@]} issue(s):${NC}"
        local f
        for f in "${FAILED_STEPS[@]}"; do
            echo -e "   ${RED}•${NC} $f"
        done
        echo -e "${YELLOW}LazyChad may still work; re-run 'lazychad-deps' after fixing the above.${NC}"
    fi
    echo -e "Start the editor with ${BOLD}lchad${NC}; run ${BOLD}lchad --doctor${NC} any time to check your setup."
    echo -e "Log: $LAZYCHAD_STATE/lazychad-deps.log\n"
}

main() {
    parse_args "$@"

    if [ "$EUID" -eq 0 ]; then
        echo -e "${RED}❌ Please DO NOT run this script as root or with sudo!${NC}"
        echo -e "Run it as your normal user. It will ask for your password when installing system packages."
        exit 1
    fi

    mkdir -p "$LAZYCHAD_STATE"
    exec > >(tee -a "$LAZYCHAD_STATE/lazychad-deps.log") 2>&1
    echo -e "\n===== lazychad-deps $(date '+%Y-%m-%d %H:%M:%S') ====="

    echo -e "${BOLD}${BLUE}🚀 LazyChad Dependency Installer${NC}"

    local os_name
    OS_ID="$(os_release_field ID)"
    [ -n "$OS_ID" ] || OS_ID="$(uname -s | tr '[:upper:]' '[:lower:]')"
    os_name="$(os_release_field NAME)"
    FAMILY="$(detect_family "$OS_ID" "$(os_release_field ID_LIKE)")"
    echo -e "${BOLD}${YELLOW}Detected OS: ${os_name:-$OS_ID} ($OS_ID, family: $FAMILY)${NC}"

    SUPPORTED=true
    if ! set_family_packages; then
        SUPPORTED=false
        echo -e "${YELLOW}No package list for $OS_ID; installing what doesn't need your package manager.${NC}"
    fi

    # System packages first: the Neovim download needs curl and tar.
    step_system_packages
    step_neovim
    step_node_tools
    step_python_provider
    step_neovide
    step_bootstrap
    print_summary

    # Non-zero exit if anything failed, so callers/CI can detect it.
    [ ${#FAILED_STEPS[@]} -eq 0 ]
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
